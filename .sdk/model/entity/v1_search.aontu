  name: "v1_search"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /searchalbum.php"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "Homework"
                k: "query"
                n: "a"
                or: "a"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "daft_punk"
                k: "query"
                n: "s"
                or: "s"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/searchalbum.php"
          q: {
            exist: [
              "a"
              "s"
            ]
          }
          s: [
            {
              lit: "searchalbum.php"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.album`"
          }
        }
        {
          co: {
            id: "GET /searchtrack.php"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "coldplay"
                k: "query"
                n: "s"
                or: "s"
                r: true
                t: "`$STRING`"
              }
              {
                ex: "yellow"
                k: "query"
                n: "t"
                or: "t"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/searchtrack.php"
          q: {
            exist: [
              "s"
              "t"
            ]
          }
          s: [
            {
              lit: "searchtrack.php"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.track`"
          }
        }
        {
          co: {
            id: "GET /discography-mb.php"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "s"
                or: "s"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/discography-mb.php"
          q: {
            exist: [
              "s"
            ]
          }
          s: [
            {
              lit: "discography-mb.php"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.album`"
          }
        }
        {
          co: {
            id: "GET /discography.php"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "coldplay"
                k: "query"
                n: "s"
                or: "s"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/discography.php"
          q: {
            exist: [
              "s"
            ]
          }
          s: [
            {
              lit: "discography.php"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.album`"
          }
        }
        {
          co: {
            id: "GET /search.php"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "coldplay"
                k: "query"
                n: "s"
                or: "s"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/search.php"
          q: {
            exist: [
              "s"
            ]
          }
          s: [
            {
              lit: "search.php"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.artists`"
          }
        }
      ]
    }
  }



