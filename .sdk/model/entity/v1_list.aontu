  name: "v1_list"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /trending.php"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "us"
                k: "query"
                n: "country"
                or: "country"
                r: true
                t: "`$STRING`"
              }
              {
                ex: "albums"
                k: "query"
                n: "format"
                or: "format"
                r: true
                t: "`$STRING`"
              }
              {
                ex: "itunes"
                k: "query"
                n: "type"
                or: "type"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/trending.php"
          q: {
            exist: [
              "country"
              "format"
              "type"
            ]
          }
          s: [
            {
              lit: "trending.php"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.trending`"
          }
        }
        {
