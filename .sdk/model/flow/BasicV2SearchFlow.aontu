# BasicV2SearchFlow

main: kit: flow: BasicV2SearchFlow:
{
  entity: "v2_search",
  kind: "basic",
  name: "BasicV2SearchFlow",
  step: [
    {
      i: {
        ref: "v2_search_ref01",
        srcdatavar: "v2_search_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "v2_search01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-v2_search_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicV2SearchFlow"
}