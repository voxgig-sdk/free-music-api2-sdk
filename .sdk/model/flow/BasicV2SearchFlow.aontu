# BasicV2SearchFlow

main: kit: flow: BasicV2SearchFlow:
{
  entity: "v2_search",
  kind: "basic",
  name: "BasicV2SearchFlow",
  step: [
    {
      m: {
        track_name: "track_name01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "v2_search_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicV2SearchFlow"
}