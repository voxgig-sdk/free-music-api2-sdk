  name: "BasicV2LookupFlow",
  step: [
    {
      i: {
        ref: "v2_lookup_ref01",
        srcdatavar: "v2_lookup_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "v2_lookup01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-v2_lookup_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicV2LookupFlow"
}