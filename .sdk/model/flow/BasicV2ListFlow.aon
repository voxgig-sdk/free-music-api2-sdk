# BasicV2ListFlow

main: kit: flow: BasicV2ListFlow:
{
  entity: "v2_list",
  kind: "basic",
  name: "BasicV2ListFlow",
  step: [
    {
      input: {
        ref: "v2_list_ref01",
        srcdatavar: "v2_list_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "v2_list01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-v2_list_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicV2ListFlow"
}