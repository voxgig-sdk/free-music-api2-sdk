# API Information


main: {
  kit: {
    info: {
      contact: {
        url: "https://www.theaudiodb.com"
      }
      description: "The Free Music API by TheAudioDB provides access to various music-related data, including artist details, album information, track listings, and music charts. It supports multiple query types, allowing users to search by artist or album name, retrieve top tracks, and manage user ratings."
      servers: [
        {
          description: "v1 API Server (Free Tier)"
          url: "https://www.theaudiodb.com/api/v1/json/123"
        }
        {
          description: "v1 API Server (Premium Tier)"
          url: "https://www.theaudiodb.com/api/v1/json/{apiKey}"
          variables: {
            apiKey: {
              default: "123"
              description: "Your API key (use 123 for free tier)"
            }
          }
        }
        {
          description: "v2 API Server (Premium Only)"
          url: "https://www.theaudiodb.com/api/v2/json"
        }
      ]
      termsOfService: "https://www.theaudiodb.com"
      title: "Free Music API"
      version: "1.0.0"
    }
  }
}

}